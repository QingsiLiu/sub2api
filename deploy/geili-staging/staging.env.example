# Geili 本地预发环境变量模板。
# `.github/geili/staging.sh up` 首次运行会据此生成 staging.env（已被 .gitignore 忽略）并填入随机密码。
# 其余变量沿用上游 deploy/docker-compose.yml 的默认值。

# 待验证的镜像 tag（fork GHCR：ghcr.io/qingsiliu/sub2api:<tag>）
GEILI_IMAGE_TAG=0.2.0-geili.1

# 只监听本机
BIND_HOST=127.0.0.1
SERVER_PORT=18080

# 全新空库的管理员账号（首次启动由 AUTO_SETUP 创建）
ADMIN_EMAIL=admin@staging.local
ADMIN_PASSWORD=__GENERATED__

# 数据库口令（脚本生成）
POSTGRES_PASSWORD=__GENERATED__

# 预发环境不落盘日志，看 docker logs 即可
LOG_OUTPUT_TO_FILE=false
LOG_FORMAT=console
LOG_LEVEL=info

TZ=Asia/Shanghai
